# ==========================================================
# AHLAS Backend — Ortam Değişkenleri Örneği
# Bu dosyayı ".env" olarak kopyalayıp gerçek anahtarlarla doldurun.
# ".env" ASLA git'e commit edilmez (.gitignore'da).
# ==========================================================

# --- Genel ---
APP_ENV=development

# --- Supabase ---
# Panel > Project Settings > API
# Backend için "service_role" anahtarı önerilir (RLS bypass eder, kullanıcı filtresi kodda yapılır).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=

# --- Gemini (Google AI Studio) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Groq (fallback) ---
# https://console.groq.com/keys
GROQ_API_KEY=

# --- Model adları (opsiyonel — override için) ---
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3

# --- TTS (Edge-TTS) ---
# tr-TR-EmelNeural (kadın) veya tr-TR-AhmetNeural (erkek)
TTS_VOICE=tr-TR-EmelNeural

# --- Sohbet geçmişi context boyutu ---
MAX_HISTORY_MESSAGES=20

# --- Storage ---
STORAGE_BUCKET=ahlas-media
MAX_UPLOAD_MB=20
SIGNED_URL_EXPIRES_SECONDS=3600
